{
  "version": 2,
  "builds": [
    {
      "src": "frontend/api/contact.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/(.*)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/contact",
      "dest": "frontend/api/contact.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
